---
/**
 * All <head> SEO lives here: title, description, canonical, Open Graph,
 * Twitter card, JSON-LD (Person + WebSite) and the sitemap link.
 */
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import '../styles/global.css';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
  /** Page name for non-home pages, rendered as "<title> | Avirup Basu". */
  title?: string;
  /** Unique per page, ~150 characters. Defaults to profile.description. */
  description?: string;
  /** Set on pages that shouldn't be indexed (e.g. 404). */
  noindex?: boolean;
}

const { profile, title, description = profile.description, noindex = false } = Astro.props;

const site = Astro.site!;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} — ${profile.title}`;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;

// A stable-format JPEG of the profile photo for structured data.
const photo = await getImage({ src: profile.image, width: 800, format: 'jpg' });
const photoUrl = new URL(photo.src, site).href;

const personId = new URL('/#person', site).href;
const websiteId = new URL('/#website', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: profile.name,
      url: profile.url,
      image: photoUrl,
      jobTitle: profile.jobTitle,
      description: profile.description,
      worksFor: {
        '@type': 'Organization',
        name: profile.company,
        ...(profile.companyUrl ? { url: profile.companyUrl } : {}),
      },
      homeLocation: { '@type': 'Place', name: profile.location },
      knowsAbout: profile.knowsAbout,
      sameAs: profile.profiles.map((p) => p.url),
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: new URL('/', site).href,
      name: profile.name,
      inLanguage: 'en',
      publisher: { '@id': personId },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={title ? 'website' : 'profile'} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.title}`} />
    <meta property="og:locale" content="en_IN" />
    {!title && <meta property="profile:first_name" content={profile.name.split(' ')[0]} />}
    {!title && <meta property="profile:last_name" content={profile.name.split(' ').slice(1).join(' ')} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
